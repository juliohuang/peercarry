{
  "manifest_version": 3,
  "name": "PeerCarry Login Assist",
  "version": "0.1.0",
  "minimum_chrome_version": "106",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "webNavigation"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "PeerCarry Login Assist" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
